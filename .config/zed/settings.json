{
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  // --- Editor Appearance & Behavior ---
  "ui_font_size": 14,
  "buffer_font_size": 13,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "Ayu Dark"
  },
  "soft_wrap": "editor_width",
  "preferred_line_length": 100,
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "format_on_save": "on",
  "inlay_hints": {
    "enabled": true
  },
  "scrollbar": {
    "show": "auto"
  },

  // --- Terminal ---
  "terminal": {
    "font_size": 13,
    "copy_on_select": true,
    "dock": "bottom"
  },

  // --- Language Specific Configurations ---
  "languages": {
    "Go": {
      "tab_size": 4,
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    },
    "YAML": {
      "tab_size": 2,
      "language_servers": ["yaml-language-server"]
    }
  },

  // --- Kubernetes & Cloud-Native Schema Support ---
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemaStore": {
            "enable": true
          },
          "schemas": {
            "kubernetes": ["**/k8s/*.yaml", "manifests/*.yaml", "deployment.yaml"]
          }
        }
      }
    },
    "gopls": {
      "settings": {
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "parameterNames": true
        }
      }
    }
  },

  // --- AI Agent Settings ---
  "agent": {
    "default_model": {
      "provider": "zed.dev",
      "model": "claude-sonnet-4-6", // As per your existing config
      "enable_thinking": true,
      "effort": "medium"
    },
    "favorite_models": [],
    "model_parameters": []
  }
}
