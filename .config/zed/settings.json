// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "colorize_brackets": true,
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "split",
  "agent_servers": {
    "gemini": {
      "type": "registry"
    }
  },
  "language_models": {
    "openai_compatible": {
      "NIM glm4.7": {
        "api_url": "https://integrate.api.nvidia.com/v1",
        "available_models": [
          {
            "name": "z-ai/glm4.7",
            "max_tokens": 200000,
            "max_output_tokens": 32000,
            "max_completion_tokens": 200000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true
            }
          }
        ]
      }
    }
  },
  "ssh_connections": [
    {
      "host": "",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/vitap/kube-burner"
          ]
        },
        {
          "paths": [
            "/home/vitap/kube-burner/kube-burner/./"
          ]
        }
      ]
    }
  ],
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "context_servers": {
    "mcp-server-github": {
      "enabled": true,
      "remote": false,
      "settings": {
        "github_personal_access_token": ""
      }
    }
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  // --- Editor Appearance & Behavior ---
  "ui_font_size": 14,
  "buffer_font_size": 13,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark"
  },
  "soft_wrap": "editor_width",
  "preferred_line_length": 100,
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "format_on_save": "on",
  "inlay_hints": {
    "enabled": true
  },
  "scrollbar": {
    "show": "auto"
  },

  // --- Terminal ---
  "terminal": {
    "font_size": 13,
    "copy_on_select": true,
    "dock": "bottom"
  },

  // --- Language Specific Configurations ---
  "languages": {
    "Go": {
      "tab_size": 4,
      "format_on_save": "on",
      "formatter": "language_server"
    },
    "Python": {
      "language_servers": ["basedpyright", "ruff"],
      "format_on_save": "on",
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      }
    },
    "YAML": {
      "tab_size": 2,
      "language_servers": ["yaml-language-server"]
    }
  },

  // --- Kubernetes & Cloud-Native Schema Support ---
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemaStore": {
            "enable": true
          },
          "schemas": {
            "kubernetes": ["**/k8s/*.yaml", "manifests/*.yaml", "deployment.yaml"]
          }
        }
      }
    },
    "gopls": {
      "settings": {
        "hints": {
          "assignVariableTypes": true,
          "compositeLiteralFields": true,
          "parameterNames": true
        }
      }
    }
  },

  // --- AI Agent Settings ---
  "agent": {
    "tool_permissions": {
      "tools": {
        "terminal": {
          "default": "allow"
        }
      }
    },
    "dock": "right",
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "gpt-5.5", // As per your existing config
      "enable_thinking": true
    },
    "favorite_models": [],
    "model_parameters": []
  }
}
